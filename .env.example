# Copy to .env.local (never committed) and fill in. Setup steps for each value:
# docs/api-setup-guide.md. On Vercel, the same names are project env vars.

# ---- Server only (never VITE_) ----
DJANGO_SECRET_KEY=
DEBUG=1
# Comma-separated. Vercel adds the deployment's own URL itself.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated full origins, e.g. https://mytruckpilot.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
# Neon pooled connection (host contains "-pooler"), used by the app
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon direct connection, used only from this PC for migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-XXXX.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Local Postgres used only by the tests (never Neon); pytest creates test_<name> itself
TEST_DATABASE_URL=
# Local only: adds POST /api/test/sign-in for end-to-end tests. Needs DEBUG=1; refused on Vercel.
# E2E_MODE=1
GOOGLE_CLIENT_ID=
TOMTOM_API_KEY=
GEOAPIFY_API_KEY=
SENTRY_DSN=

# ---- Browser build (public by design) ----
VITE_GOOGLE_CLIENT_ID=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
